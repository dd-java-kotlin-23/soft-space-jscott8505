<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="8dp"
  app:cardCornerRadius="10dp"
  app:cardElevation="2dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
      android:id="@+id/text_event_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Sensory Friendly Hour"
      android:textSize="16sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/text_event_location"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="📍 Main Community Center"
      android:textColor="#666666"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/text_event_description"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="Dimmed lighting, quiet spaces, and reduced noise levels available."
      android:textSize="13sp" />

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>