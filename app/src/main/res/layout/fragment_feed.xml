<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?attr/colorSurface">

  <!-- 1. TOP HEADER BAR -->
  <LinearLayout
    android:id="@+id/layout_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentTop="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="#555555">

    <!-- Search Bar -->
    <com.google.android.material.textfield.TextInputLayout
      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      app:boxBackgroundColor="#EFEFEF"
      app:boxCornerRadiusBottomEnd="8dp"
      app:boxCornerRadiusBottomStart="8dp"
      app:boxCornerRadiusTopEnd="8dp"
      app:boxCornerRadiusTopStart="8dp"
      app:boxStrokeWidth="0dp"
      app:endIconDrawable="@android:drawable/ic_menu_search"
      app:endIconMode="custom"
      app:hintEnabled="false">

      <com.google.android.material.textfield.TextInputEditText
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="Search"
        android:padding="0dp"
        android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Notification Bell -->
    <ImageView
      android:id="@+id/btn_settings"
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_marginStart="16dp"
      android:contentDescription="@string/settings_label"
      android:src="@drawable/outline_settings_24" />
  </LinearLayout>

  <!-- 2. SCROLLABLE FEED CONTENT -->
  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_above="@id/bottom_navigation"
    android:layout_below="@id/layout_header"
    android:fillViewport="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="20dp">

      <!-- Yellow Banner / Title Block 1 -->
      <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:background="#D0D0D0" />

      <!-- Subtitle/Paragraph Block 1 -->
      <TextView
        android:layout_width="180dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:background="#D0D0D0" />

      <!-- Subtitle/Paragraph Block 2 -->
      <TextView
        android:layout_width="160dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:background="#D0D0D0" />

      <!-- Yellow Banner / Title Block 2 -->
      <TextView
        android:layout_width="260dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:background="#D0D0D0" />

      <!-- Image Upload / Preview Card -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#EAEAEA"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <ImageView
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_gravity="center"
          android:src="@android:drawable/ic_menu_gallery"
          app:tint="#5C6BC0" />
      </com.google.android.material.card.MaterialCardView>

      <!-- Yellow Text Highlight Block -->
      <TextView
        android:layout_width="280dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:background="#D0D0D0" />

      <!-- Bottom Paragraph Block -->
      <TextView
        android:layout_width="140dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:background="#D0D0D0" />

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <!-- 3. BOTTOM NAVIGATION BAR -->
  <LinearLayout
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_alignParentBottom="true"
    android:background="#555555"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp">

    <!-- Chat / Feed Tab -->
    <ImageView
      android:id="@+id/nav_chat"
      android:layout_width="0dp"
      android:layout_height="28dp"
      android:layout_weight="1"
      android:contentDescription="@string/messages_label"
      android:src="@android:drawable/sym_action_chat"/>

    <!-- Calendar Tab -->
    <ImageView
      android:id="@+id/nav_calendar"
      android:layout_width="0dp"
      android:layout_height="28dp"
      android:layout_weight="1"
      android:contentDescription="@string/calendar_label"
      android:src="@drawable/outline_calendar_month_24"/>


    <!-- Profile Tab -->
    <ImageView
      android:id="@+id/nav_profile"
      android:layout_width="0dp"
      android:layout_height="32dp"
      android:layout_weight="1"
      android:src="@drawable/outline_account_circle_24"/>

  </LinearLayout>

</RelativeLayout>