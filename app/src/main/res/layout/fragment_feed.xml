<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?attr/colorSurface">

  <!-- 1. TOP HEADER BAR -->
  <LinearLayout
    android:id="@+id/layout_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentTop="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="#555555">

    <!-- Search Bar -->
    <com.google.android.material.textfield.TextInputLayout
      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      app:boxBackgroundColor="#EFEFEF"
      app:boxCornerRadiusBottomEnd="8dp"
      app:boxCornerRadiusBottomStart="8dp"
      app:boxCornerRadiusTopEnd="8dp"
      app:boxCornerRadiusTopStart="8dp"
      app:boxStrokeWidth="0dp"
      app:endIconDrawable="@android:drawable/ic_menu_search"
      app:endIconMode="custom"
      app:hintEnabled="false">

      <com.google.android.material.textfield.TextInputEditText
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="@string/search_label"
        android:padding="0dp"
        android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Notification Bell -->
    <ImageView
      android:id="@+id/btn_settings"
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_marginStart="16dp"
      android:contentDescription="@string/settings_label"
      android:src="@drawable/outline_settings_24" />
  </LinearLayout>

  <!-- 2. SCROLLABLE FEED CONTENT -->
  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/recycler_feed"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_above="@id/bottom_navigation"
    android:layout_below="@id/layout_header"
    android:clipToPadding="false"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"/>

  <!-- 3. BOTTOM NAVIGATION BAR -->
  <LinearLayout
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_alignParentBottom="true"
    android:background="#555555"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp">

    <!-- Chat / Feed Tab -->
    <ImageView
      android:id="@+id/nav_chat"
      android:layout_width="0dp"
      android:layout_height="28dp"
      android:layout_weight="1"
      android:contentDescription="@string/messages_label"
      android:src="@android:drawable/sym_action_chat"/>

    <!-- Calendar Tab -->
    <ImageView
      android:id="@+id/nav_calendar"
      android:layout_width="0dp"
      android:layout_height="28dp"
      android:layout_weight="1"
      android:contentDescription="@string/calendar_label"
      android:src="@drawable/outline_calendar_month_24"/>


    <!-- Profile Tab -->
    <ImageView
      android:id="@+id/nav_profile"
      android:layout_width="0dp"
      android:layout_height="32dp"
      android:layout_weight="1"
      android:src="@drawable/outline_account_circle_24"/>

  </LinearLayout>

</RelativeLayout>
