<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/nav_graph"
  app:startDestination="@id/signInFragment">

  <fragment
    android:id="@+id/signInFragment"
    android:name="edu.cnm.deepdive.softspace.ui.auth.SignInFragment"
    android:label="@string/sign_in"
    tools:layout="@layout/fragment_sign_in">
    <action
      android:id="@+id/action_signInFragment_to_feedFragment"
      app:destination="@id/feedFragment"
      app:popUpTo="@id/signInFragment"
      app:popUpToInclusive="true"/>
  </fragment>

  <fragment
    android:id="@+id/feedFragment"
    android:name="edu.cnm.deepdive.softspace.ui.feed.FeedFragment"
    android:label="@string/feed"
    tools:layout="@layout/fragment_feed">
    <action
      android:id="@+id/action_feedFragment_to_messagesFragment"
      app:destination="@id/messagesFragment"/>
    <action
      android:id="@+id/action_feedFragment_to_calendarFragment"
      app:destination="@id/calendarFragment"/>
    <action
      android:id="@+id/action_feedFragment_to_profileFragment"
      app:destination="@id/profileFragment"/>
    <action
      android:id="@+id/action_feedFragment_to_postDetailFragment"
      app:destination="@id/postDetailFragment"/>
  </fragment>

  <fragment
    android:id="@+id/messagesFragment"
    android:name="edu.cnm.deepdive.softspace.ui.feed.MessagesFragment"
    android:label="@string/messages_label"
    tools:layout="@layout/fragment_messages">
    <action
      android:id="@+id/action_messagesFragment_to_conversationFragment"
      app:destination="@id/conversationFragment"/>
  </fragment>

  <fragment
    android:id="@+id/calendarFragment"
    android:name="edu.cnm.deepdive.softspace.ui.feed.CalendarFragment"
    android:label="@string/calendar_label"
    tools:layout="@layout/fragment_calendar">
    <action
      android:id="@+id/action_calendarFragment_to_eventDetailFragment"
      app:destination="@id/eventDetailFragment"/>
  </fragment>

  <fragment
    android:id="@+id/profileFragment"
    android:name="edu.cnm.deepdive.softspace.ui.profile.ProfileFragment"
    android:label="@string/profile"
    tools:layout="@layout/fragment_profile">
    <action
      android:id="@+id/action_profileFragment_to_signInFragment"
      app:destination="@id/signInFragment"
      app:popUpTo="@id/nav_graph"
      app:popUpToInclusive="true"/>
    <action
      android:id="@+id/action_profileFragment_to_profilePageFragment"
      app:destination="@id/profilePageFragment"/>
  </fragment>

  <fragment
    android:id="@+id/profilePageFragment"
    android:name="edu.cnm.deepdive.softspace.ui.profile.ProfilePage"
    android:label="@string/profile"
    tools:layout="@layout/profile_page">
    <argument
      android:name="userId"
      app:argType="string"/>
    <action
      android:id="@+id/action_profilePageFragment_to_feedFragment"
      app:destination="@id/feedFragment"/>
  </fragment>

  <fragment
    android:id="@+id/postDetailFragment"
    android:name="edu.cnm.deepdive.softspace.ui.post.PostDetailFragment"
    android:label="@string/post_details"
    tools:layout="@layout/fragment_post_detail">
    <argument
      android:name="postId"
      app:argType="long"/>
  </fragment>

  <fragment
    android:id="@+id/eventDetailFragment"
    android:name="edu.cnm.deepdive.softspace.ui.event.EventDetailFragment"
    android:label="@string/event_details"
    tools:layout="@layout/fragment_event_detail">
    <argument
      android:name="eventId"
      app:argType="long"/>
  </fragment>

  <fragment
    android:id="@+id/conversationFragment"
    android:name="edu.cnm.deepdive.softspace.ui.message.ConversationFragment"
    android:label="@string/conversation"
    tools:layout="@layout/fragment_conversation">
    <argument
      android:name="messageId"
      app:argType="long"/>
  </fragment>

</navigation>
