<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/nav_graph"
  app:startDestination="@id/signInFragment">

  <fragment
    android:id="@+id/signInFragment"
    android:name="edu.cnm.deepdive.softspace.ui.auth.SignInFragment"
    android:label="@string/sign_in"
    tools:layout="@layout/fragment_sign_in">
    <action
      android:id="@+id/action_signInFragment_to_feedFragment"
      app:destination="@id/feedFragment"
      app:popUpTo="@id/signInFragment"
      app:popUpToInclusive="true"/>
  </fragment>

  <fragment
    android:id="@+id/feedFragment"
    android:name="edu.cnm.deepdive.softspace.ui.feed.FeedFragment"
    android:label="@string/feed"
    tools:layout="@layout/fragment_feed">
    <action
      android:id="@+id/action_feedFragment_to_messagesFragment"
      app:destination="@id/messagesFragment"/>
    <action
      android:id="@+id/action_feedFragment_to_calendarFragment"
      app:destination="@id/calendarFragment"/>
    <action
      android:id="@+id/action_feedFragment_to_profileFragment"
      app:destination="@id/profileFragment"/>
  </fragment>

  <fragment
    android:id="@+id/messagesFragment"
    android:name="edu.cnm.deepdive.softspace.ui.feed.MessagesFragment"
    android:label="@string/messages_label"
    tools:layout="@layout/fragment_messages"/>

  <fragment
    android:id="@+id/calendarFragment"
    android:name="edu.cnm.deepdive.softspace.ui.feed.CalendarFragment"
    android:label="@string/calendar_label"
    tools:layout="@layout/fragment_calendar"/>

  <fragment
    android:id="@+id/profileFragment"
    android:name="edu.cnm.deepdive.softspace.ui.profile.ProfileFragment"
    android:label="@string/profile"
    tools:layout="@layout/fragment_profile">
    <action
      android:id="@+id/action_profileFragment_to_signInFragment"
      app:destination="@id/signInFragment"
      app:popUpTo="@id/nav_graph"
      app:popUpToInclusive="true"/>
  </fragment>

</navigation>
